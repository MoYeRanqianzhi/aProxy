{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aProxy",
  "identifier": "io.github.moyeranqianzhi.aproxy",
  "build": {
    "frontendDist": "dist",
    "windows": {
      "staticVCRuntime": false
    }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-eval' https: blob: http://aproxy-pkg.localhost aproxy-pkg:",
        "style-src": "'self' 'unsafe-inline' https: blob: data: http://aproxy-pkg.localhost aproxy-pkg:",
        "img-src": "'self' https: blob: data: http://aproxy-pkg.localhost aproxy-pkg:",
        "font-src": "'self' https: blob: data: http://aproxy-pkg.localhost aproxy-pkg:",
        "media-src": "'self' https: blob: data: http://aproxy-pkg.localhost aproxy-pkg:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: blob: data: http://aproxy-pkg.localhost aproxy-pkg:",
        "worker-src": "'self' blob: https: http://aproxy-pkg.localhost aproxy-pkg:",
        "frame-src": "'self' https: blob: http://aproxy-pkg.localhost aproxy-pkg:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "publisher": "aProxy Contributors",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
