{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main window may use these named aProxy operations and native appearance controls.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:allow-show",
    "core:window:allow-set-effects",
    "core:window:allow-set-theme",
    "allow-desktop-info",
    "allow-titlebar-insets",
    "allow-set-caption-color",
    "allow-rescan",
    "allow-attach",
    "allow-detach",
    "allow-ack",
    "allow-snapshot",
    "allow-query-logs",
    "allow-request-detail",
    "allow-body-chunk",
    "allow-cancel-detail",
    "allow-list-configs",
    "allow-start-instance",
    "allow-stop-instance",
    "allow-restart-instance",
    "allow-force-stop-instance",
    "allow-restore-instance",
    "allow-forget-restore"
  ]
}
