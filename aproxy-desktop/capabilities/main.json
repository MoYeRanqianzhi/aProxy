{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main window may use these named aProxy operations and native appearance controls.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:allow-show",
    "core:window:allow-set-effects",
    "core:window:allow-set-theme",
    "allow-desktop-info",
    "allow-titlebar-insets",
    "allow-set-caption-color",
    "allow-rescan",
    "allow-attach",
    "allow-detach",
    "allow-ack",
    "allow-snapshot",
    "allow-query-logs",
    "allow-request-detail",
    "allow-body-chunk",
    "allow-cancel-detail",
    "allow-list-configs",
    "allow-start-instance",
    "allow-stop-instance",
    "allow-restart-instance",
    "allow-force-stop-instance",
    "allow-restore-instance",
    "allow-forget-restore",
    "allow-read-config",
    "allow-validate-config",
    "allow-write-config",
    "allow-read-settings",
    "allow-set-watchdog",
    "allow-read-desktop-state",
    "allow-set-preferences",
    "allow-set-pinned",
    "allow-about",
    "allow-check-update",
    "allow-install-update",
    "allow-read-autostart",
    "allow-set-autostart",
    "allow-extension-list",
    "allow-extension-enable",
    "allow-extension-open",
    "allow-extension-close",
    "allow-extension-query-logs",
    "allow-extension-request-detail",
    "allow-extension-body-chunk",
    "allow-extension-cancel-detail",
    "allow-extension-list-configs",
    "allow-extension-read-config",
    "allow-extension-update-offer",
    "allow-extension-pending",
    "allow-extension-answer",
    "allow-extension-revoke",
    "allow-extension-audit",
    "allow-extension-start",
    "allow-extension-stop",
    "allow-extension-restart",
    "allow-extension-install"
  ]
}
