{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aProxy",
  "identifier": "io.github.moyeranqianzhi.aproxy",
  "build": {
    "frontendDist": "dist",
    "windows": {
      "staticVCRuntime": false
    }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "publisher": "aProxy Contributors",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
